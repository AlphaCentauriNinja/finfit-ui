# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# FinFit API Configuration
NEXT_PUBLIC_FINFIT_API_URL=http://localhost:4000/api
NEXT_PUBLIC_FINFIT_API_TOKEN=your-finfit-api-token

# Server-side proxy variables (used by /api/proxy/* routes - never exposed to browser)
FINFIT_API_INTERNAL_URL=http://localhost:4000/api/v1
FINFIT_API_TOKEN=your-api-token